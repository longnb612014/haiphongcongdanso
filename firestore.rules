rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hồ sơ học sinh: chỉ chính chủ mới đọc/ghi được hồ sơ của mình.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tiến trình chơi: mọi học sinh đã đăng nhập đều đọc được (để hiển thị
    // Bảng xếp hạng), nhưng chỉ chính chủ mới được ghi/sửa tiến trình của mình.
    match /progress/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
